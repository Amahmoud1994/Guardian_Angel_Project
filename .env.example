# ── Guardian Angel · SMTP Configuration ──────────────────────────────────────
#
# Copy this file to .env and fill in your credentials.
# The app reads these on startup via python-dotenv.
#
# ── Gmail setup (recommended for testing) ────────────────────────────────────
#  1. Enable 2-Step Verification on your Google account
#     https://myaccount.google.com/security
#  2. Create an App Password (Google Account → Security → App Passwords)
#     Choose "Mail" + "Windows Computer" → copy the 16-char password
#  3. Paste that password as SMTP_PASS below (no spaces)
#
# ── Other providers ───────────────────────────────────────────────────────────
#  Outlook/Office365 : SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#  Yahoo             : SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
#  SendGrid          : SMTP_HOST=smtp.sendgrid.net    SMTP_PORT=587
#                      SMTP_USER=apikey  SMTP_PASS=<your-sendgrid-api-key>
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Guardian Angel <your-email@gmail.com>

# ── App base URL ──────────────────────────────────────────────────────────────
# Used to build the "View Details & Reply" guardian link in alert emails.
# Local dev: leave as-is. After deploying, set this to your real HTTPS URL
# (e.g. https://guardian-angel-xxxx.onrender.com) so the link in emails works.
APP_BASE_URL=http://localhost:8000

# ── Security (all optional — auto-generated and persisted locally if unset) ────
# COOKIE_SECURE=false            # only for local http:// testing if needed; defaults to true
# ALLOWED_ORIGINS=http://localhost:8000   # comma-separated if serving from more than one origin
# CASE_FILE_ENCRYPTION_KEY=      # Fernet key; auto-generated into case_key.json if unset
# DISABLE_RATE_LIMIT=false       # tests set this to true automatically — leave false in production
